server {
    listen 443 ssl;
    server_name ${GUARDIAN_HTTPS_HOST};
    if ($host != ${GUARDIAN_HTTPS_HOST}) { return 421; }
    ssl_certificate /tls/fullchain.pem;
    ssl_certificate_key /tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;
    root /usr/share/nginx/html;

    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'" always;

    location ~ ^/(api/v1|health)/ {
        resolver 127.0.0.11 valid=10s;
        set $upstream http://api:8080;
        proxy_pass $upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
